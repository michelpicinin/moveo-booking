# --- Required ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
APP_URL=https://book.moveo.lu
STAFF_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# --- Studio settings (confirmed by MOVEO 2026-11-04) ---
PRICE_DROPIN_CENTS=3500
PRICE_CARD10_CENTS=30000
CARD_CREDITS=10
CARD_VALIDITY_DAYS=90
CANCEL_HOURS=12
TRIAL_ENABLED=true
CURRENCY=eur
STUDIO_NAME=MOVEO Belair
STUDIO_ADDRESS=Belair, Luxembourg

# --- Stripe (Apple Pay, Google Pay, cards) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Apple Wallet (Apple Developer account) ---
PASS_TYPE_ID=
APPLE_TEAM_ID=
PASS_SIGNER_CERT=
PASS_SIGNER_KEY=
PASS_SIGNER_KEY_PASSPHRASE=
PASS_WWDR_CERT=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=MOVEO Yoga <yoga@moveo.lu>
EMAIL_REPLY_TO=
# Gets a copy of every booking and card sale
STUDIO_NOTIFY_EMAIL=

# Dev/demo only: simulated payments when no Stripe key is set
ALLOW_MOCK_PAYMENTS=false
